# InfraWatch Nexus — Environment Variables
# Copy this file to .env and fill in your API keys

# WeatherAPI.com key (free tier: https://www.weatherapi.com/signup.aspx)
WX_API_KEY=

# Google AI Studio Gemini API key (free: https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Admin authentication token (legacy support)
ADMIN_TOKEN=your_secret_admin_token_here

# HMAC Secret for JWT equivalent token generation (v5.0 and v6.0)
ADMIN_SECRET=your_hmac_secret_goes_here

# ────────────────────────────────────────
# SPONSOR INTEGRATIONS
# ────────────────────────────────────────

# Auth0: Civic identity, JWT validation, gamification
# Dashboard: https://manage.auth0.com
# ── Auth0 (Citizen Identity) ────────────────────────
# Served via /api/config to frontend (v5.0+)
AUTH0_DOMAIN=your_auth0_domain
AUTH0_CLIENT_ID=your_auth0_client_id
AUTH0_AUDIENCE=https://infrawatch-nexus-api

# ElevenLabs: Hindi TTS for voice alerts and AI responses
# Get key: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=56k72tYpS6hbRADdszYg

# Vultr Object Storage: Evidence photo cloud storage
# Get keys: https://my.vultr.com/objectstorage/
VULTR_ACCESS_KEY=
VULTR_SECRET_KEY=
VULTR_BUCKET=infrawatch-evidence
VULTR_ENDPOINT=https://ewr1.vultrobjects.com
